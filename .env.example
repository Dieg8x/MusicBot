DISCORD_TOKEN=your_bot_token_here
# Optional: set if you want to pass the application ID explicitly
DISCORD_APPLICATION_ID=123456789012345678
# Optional: comma-separated guild IDs to speed up slash command sync during testing
GUILD_IDS=111111111111111111,222222222222222222
# Optional: set a shard count if running in many guilds; otherwise leave empty to auto-scale
SHARD_COUNT=
